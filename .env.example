# ==============================================================================
# Rent It / Heavy Equipment Rental System - Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), configure these variables in Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Clerk Authentication (Required)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (exposed to browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Secret Key (Server-only secret)
CLERK_SECRET_KEY=sk_test_...

# Clerk Routing URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk Webhook Secret (Required for syncing user creations to Supabase via /api/webhooks/clerk)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 2. Supabase Database & Storage (Required)
# ------------------------------------------------------------------------------
# Canonical Supabase Project URL
# Primary project ref: puafxhgawvtumxzsxsrz
NEXT_PUBLIC_SUPABASE_URL=https://puafxhgawvtumxzsxsrz.supabase.co

# Supabase Publishable / Anon Key (Safe for browser and user-authenticated queries)
# (Supported aliases: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase Service Role Secret Key (Server-only, bypasses RLS for webhooks & admin jobs)
# (Supported aliases: SUPABASE_KEY_SECRET, SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_KEY_SECRET=eyJ...

# ------------------------------------------------------------------------------
# 3. Application Domain (Optional / Production)
# ------------------------------------------------------------------------------
# Base URL for email notifications, administrative links, or full absolute URLs
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
